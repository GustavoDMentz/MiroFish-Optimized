# ===== LLM Principal (simulação de agentes) =====
# Compatível com qualquer API no formato OpenAI: Gemini, DeepSeek, Qwen, etc.
# Recomendado: Google AI Studio — https://aistudio.google.com/
LLM_API_KEY=sua_chave_aqui
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL_NAME=gemma-3-27b-it

# ===== Embeddings (grafo de conhecimento) =====
# Recomendado: Google Gemini Embedding 2 (gratuito e de alta qualidade)
# Se não configurado, utiliza os mesmos valores do LLM Principal acima
EMBEDDING_API_KEY=sua_chave_google_ai_studio
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL_NAME=text-embedding-004

# ===== LLM de Aceleração (opcional) =====
# Usado para tarefas rápidas como extração e classificação
# Se não configurado, o LLM Principal é usado para tudo
# LLM_BOOST_API_KEY=sua_chave
# LLM_BOOST_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_BOOST_MODEL_NAME=gemma-3-4b-it

# ===== Memória Zep (opcional) =====
# Gratuito para uso básico: https://app.getzep.com/
# Se não configurado, a memória local é usada
ZEP_API_KEY=sua_chave_zep_aqui

# ===== Memgraph (opcional — busca vetorial em grafo) =====
# Deixe MEMGRAPH_HOST vazio para usar busca vetorial local (DuckDB + NumPy)
# sem necessidade de infraestrutura adicional
MEMGRAPH_HOST=
MEMGRAPH_PORT=7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=

# ===== Local security defaults =====
# Do not enable Flask debug on a network-accessible deployment.
FLASK_DEBUG=False
FLASK_HOST=127.0.0.1
# For persistent Flask sessions, set a strong, private value in .env:
# SECRET_KEY=<generate-with-python-secrets-token-hex-32>
# Explicitly list trusted frontend origins (comma-separated) when customized:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
